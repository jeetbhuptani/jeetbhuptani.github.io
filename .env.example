# ---------------------------------------------------------------- existing
GITHUB_TOKEN=
HARDCOVER_API_TOKEN=

# ------------------------------------------------------- Supabase (content)
# Dashboard -> Project Settings -> API Keys. The site falls back to committed
# seed content when these are absent, so it stays deployable without them.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Client-side key. Safe to expose; RLS is what protects the data.
# Prefer the new publishable key (sb_publishable_...). The legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY name is still read as a fallback, because that
# is what the Vercel<->Supabase integration injects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS entirely, so it must never be NEXT_PUBLIC_ and must
# never be imported into a client component. Used only after the AAL2 guard.
# Legacy fallback name: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sb_secret_...

# The single email allowed into /admin. Any other authenticated user is
# rejected before a password is checked.
ADMIN_EMAIL=

# ---------------------------------------------------- Cloudinary (/life media)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
